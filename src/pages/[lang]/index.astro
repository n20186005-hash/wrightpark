---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import InfoCard from '../../components/InfoCard.astro';
import Intro from '../../components/Intro.astro';
import History from '../../components/History.astro';
import Architecture from '../../components/Architecture.astro';
import WeatherSection from '../../components/WeatherSection.astro';
import GuideSection from '../../components/GuideSection.astro';
import RoutesSection from '../../components/RoutesSection.astro';
import AudiencesSection from '../../components/AudiencesSection.astro';
import BestTime from '../../components/BestTime.astro';
import SeasonsSection from '../../components/SeasonsSection.astro';
import Transport from '../../components/Transport.astro';
import Facilities from '../../components/Facilities.astro';
import ScienceSection from '../../components/ScienceSection.astro';
import Safety from '../../components/Safety.astro';
import FAQ from '../../components/FAQ.astro';
import MapSection from '../../components/MapSection.astro';
import Gallery from '../../components/Gallery.astro';
import Nearby from '../../components/Nearby.astro';
import ReviewsSection from '../../components/ReviewsSection.astro';
import SourcesSection from '../../components/SourcesSection.astro';
import { ui } from '../../i18n/ui';

export function getStaticPaths() {
  return (['tl', 'en'] as const).map((lang) => ({
    params: { lang },
    props: { lang },
  }));
}

const { lang } = Astro.props;
const messages = ui[lang];
---

<BaseLayout lang={lang} messages={messages}>
  <Hero lang={lang} messages={messages} />
  <InfoCard lang={lang} messages={messages} />
  <Intro lang={lang} messages={messages} />
  <History lang={lang} messages={messages} />
  <Architecture lang={lang} messages={messages} />
  <WeatherSection lang={lang} messages={messages} />
  <GuideSection lang={lang} messages={messages} />
  <RoutesSection lang={lang} messages={messages} />
  <AudiencesSection lang={lang} messages={messages} />
  <BestTime lang={lang} messages={messages} />
  <SeasonsSection lang={lang} messages={messages} />
  <Transport lang={lang} messages={messages} />
  <Facilities lang={lang} messages={messages} />
  <ScienceSection lang={lang} messages={messages} />
  <Safety lang={lang} messages={messages} />
  <Gallery lang={lang} messages={messages} />
  <MapSection lang={lang} messages={messages} />
  <Nearby lang={lang} messages={messages} />
  <ReviewsSection lang={lang} messages={messages} />
  <FAQ lang={lang} messages={messages} />
  <SourcesSection lang={lang} messages={messages} />
</BaseLayout>
