---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LegalPage from '../../components/LegalPage.astro';
import { ui } from '../../i18n/ui';

export function getStaticPaths() {
  return (['tl', 'en'] as const).map((lang) => ({
    params: { lang },
    props: { lang },
  }));
}

const { lang } = Astro.props;
const messages = ui[lang];
const legalTitle = `${messages.legal.cookie.title} — Wright Park Guide`;
---

<BaseLayout lang={lang} messages={messages} path="cookie-settings" noindex pageTitle={legalTitle}>
  <LegalPage lang={lang} messages={messages} kind="cookie" />
</BaseLayout>
