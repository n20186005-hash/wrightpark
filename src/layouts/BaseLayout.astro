---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { siteConfig } from '../config';
import { attraction, mapsUrl, govtTourismUrl, ogLocale } from '../config';
import { buildAlternates, htmlLangAttr, languagesList } from '../i18n/ui';

interface Props {
  lang: string;
  messages: any;
  path?: string;
}
const { lang, messages, path = '' } = Astro.props;

const title = messages.meta?.title ?? siteConfig.name;
const description = messages.meta?.description ?? '';
const ogTitle = messages.meta?.ogTitle ?? title;
const ogDescription = messages.meta?.ogDescription ?? description;
const heroImage = `${siteConfig.baseUrl}/gallery/wright-park-pool-of-pines-daybreak-1.jpg`;
const image = heroImage;
const images = [
  `${siteConfig.baseUrl}/gallery/wright-park-pool-of-pines-daybreak-1.jpg`,
  `${siteConfig.baseUrl}/gallery/wright-park-pine-forest-morning-mist-2.jpg`,
  `${siteConfig.baseUrl}/gallery/wright-park-pool-of-pines-golden-hour-7.jpg`,
  `${siteConfig.baseUrl}/gallery/wright-park-baguio-city-aerial-pines-12.jpg`,
];
const imageAlt = lang === 'tl'
  ? 'Wright Park (Luneta ng mga Pino) - Pangunahing tanawin sa Lungsod ng Baguio, Pilipinas'
  : 'Wright Park (Pool of Pines) - Main view in Baguio City, Philippines';
const fullName = attraction.name[lang] ?? attraction.name.en;
const shortName = attraction.shortName[lang] ?? attraction.shortName.en;
const cityName = attraction.city[lang] ?? attraction.city.en;
const regionName = attraction.region[lang] ?? attraction.region.en;
const countryName = attraction.country[lang] ?? attraction.country.en;
const postalCode = attraction.postalCode;
const entityId = `${siteConfig.baseUrl}/#attraction`;

const basePath = path ? '/' + path.replace(/^\/+|\/+$/g, '') : '';
const canonical = `${siteConfig.baseUrl}/${lang}${basePath}`;
const url = `${siteConfig.baseUrl}/${lang}${basePath}`;
const alternates = buildAlternates(path);
const htmlLang = htmlLangAttr(lang);

const siteNameFallback = siteConfig.name;

const faqItems = (messages.faq?.items ?? []).map((it: any) => ({
  '@type': 'Question',
  name: it.q,
  acceptedAnswer: { '@type': 'Answer', text: it.a },
}));

const isHome = path === '' || path === '/';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['TouristAttraction', 'Place'],
      '@id': entityId,
      name: fullName,
      alternateName: [shortName, `${cityName} ${fullName}`],
      description,
      url,
      image: images,
      isAccessibleForFree: attraction.isAccessibleForFree,
      address: {
        '@type': 'PostalAddress',
        streetAddress: attraction.streetAddress[lang] ?? attraction.streetAddress.en,
        addressLocality: cityName,
        addressRegion: regionName,
        postalCode,
        addressCountry: attraction.countryCode,
      },
      geo: {
        '@type': 'GeoCoordinates',
        latitude: attraction.lat,
        longitude: attraction.lng,
      },
      hasMap: mapsUrl,
      sameAs: [mapsUrl, govtTourismUrl],
      openingHoursSpecification: {
        '@type': 'OpeningHoursSpecification',
        dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
        opens: '06:00',
        closes: '18:00',
      },
    },
    {
      '@type': 'WebSite',
      '@id': `${siteConfig.baseUrl}/#website`,
      url: siteConfig.baseUrl,
      name: messages.header?.siteName ?? siteNameFallback,
      inLanguage: lang === 'tl' ? 'fil-PH' : 'en-PH',
      publisher: { '@id': entityId },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: fullName,
          item: isHome ? url : `${siteConfig.baseUrl}/${lang}`,
        },
        { '@type': 'ListItem', position: 2, name: cityName },
        { '@type': 'ListItem', position: 3, name: regionName },
        { '@type': 'ListItem', position: 4, name: countryName },
      ],
    },
    ...(faqItems.length
      ? [{ '@type': 'FAQPage', '@id': `${url}#faq`, mainEntity: faqItems }]
      : []),
  ],
};

const GA_MEASUREMENT_ID = 'G-YJTNXGWZNY';
const gaScriptSrc = `https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`;
const gaConfigSnippet = `
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', '${GA_MEASUREMENT_ID}');
`;
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#274C30" />

    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="application-name" content={messages.header?.siteName ?? siteNameFallback} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content={messages.header?.siteName ?? siteNameFallback} />
    <meta name="mobile-web-app-capable" content="yes" />
    <link rel="apple-touch-icon" href="/icons/icon-180.png" />
    <link rel="icon" type="image/svg+xml" href="/icons/icon.svg" />

    {
      Object.entries(alternates).map(([h, href]) => (
        <link
          rel="alternate"
          hreflang={h === 'xDefault' ? 'x-default' : htmlLangAttr(h)}
          href={href}
        />
      ))
    }

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={messages.header?.siteName ?? siteNameFallback} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={image} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:locale" content={ogLocale[lang] ?? lang} />
    {
      languagesList
        .filter((l) => l !== lang)
        .map((l) => <meta property="og:locale:alternate" content={ogLocale[l] ?? l} />)
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <script is:inline async src={gaScriptSrc}></script>
    <script is:inline set:html={gaConfigSnippet}></script>

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', function () {
          navigator.serviceWorker.register('/sw.js').catch(function () {
            /* service worker registration failed — site still works online */
          });
        });
      }
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link">{messages.header?.skipToContent}</a>
    <Header lang={lang} messages={messages} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} messages={messages} />
  </body>
</html>
