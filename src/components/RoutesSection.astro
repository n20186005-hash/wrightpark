---
import Icon from './Icon.astro';

interface Props {
  lang: string;
  messages: any;
}
const { messages } = Astro.props;
const routes = messages.routes;
const plans = [routes.halfDay, routes.fullDay];
---

<section id="routes" class="scroll-mt-20 bg-cream py-16 md:py-24">
  <div class="mx-auto max-w-6xl px-4">
    <p class="section-eyebrow">{routes.eyebrow}</p>
    <h2 class="mt-2 font-serif text-3xl font-bold text-green-deep md:text-4xl">{routes.title}</h2>
    <p class="mt-3 max-w-2xl text-charcoal/70">{routes.subtitle}</p>

    <div class="mt-8 grid gap-6 lg:grid-cols-2">
      {
        plans.map((plan: any) => (
          <div class="glass-card rounded-2xl p-6">
            <div class="flex items-center gap-3">
              <span class="rounded-full bg-green/10 p-3 text-green-deep">
                <Icon name="route" class="w-6 h-6" />
              </span>
              <h3 class="font-serif text-xl font-semibold text-charcoal">{plan.label}</h3>
            </div>

            <p class="mt-3 text-sm leading-relaxed text-charcoal/75">{plan.summary}</p>

            <dl class="mt-4 flex flex-wrap gap-2 text-xs">
              <span class="rounded-full bg-gold/20 px-3 py-1 text-gold-deep">
                {routes.durationLabel}: {plan.duration}
              </span>
              <span class="rounded-full bg-green-deep/10 px-3 py-1 text-green-deep">
                {routes.distanceLabel}: {plan.distance}
              </span>
            </dl>

            <ol class="mt-5 space-y-3">
              {plan.steps.map((step: string, i: number) => (
                <li class="flex items-start gap-3">
                  <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-green-deep text-xs font-semibold text-white">
                    {i + 1}
                  </span>
                  <span class="text-sm leading-relaxed text-charcoal/85">{step}</span>
                </li>
              ))}
            </ol>

            <p class="mt-5 rounded-xl border border-gold/30 bg-sand/60 p-3 text-xs leading-relaxed text-charcoal/75">
              {plan.note}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
