---
interface Props {
  lang: string;
  messages: any;
  kind: 'privacy' | 'terms' | 'cookie';
}
const { lang, messages, kind } = Astro.props;
const legal = messages.legal?.[kind];
const sections = legal?.sections ?? [];
---

<section class="bg-cream py-16 md:py-24">
  <div class="mx-auto max-w-3xl px-4">
    <h1 class="font-serif text-3xl font-bold text-green-deep md:text-4xl">{legal?.title}</h1>
    <p class="mt-2 text-sm text-charcoal/60">{legal?.lastUpdated}</p>
    <div class="mt-8 space-y-6">
      {
        sections.map((s: any) => (
          <div>
            {s.h && <h2 class="font-serif text-lg font-semibold text-charcoal">{s.h}</h2>}
            {s.p && <p class="mt-2 text-sm leading-relaxed text-charcoal/75">{s.p}</p>}
            {s.li && (
              <ul class="mt-2 list-disc space-y-1 pl-5 text-sm leading-relaxed text-charcoal/75">
                {s.li.map((item: string) => <li>{item}</li>)}
              </ul>
            )}
            {s.cookies && (
              <div class="mt-4 space-y-4">
                {s.cookies.map((c: any) => (
                  <div class="rounded-xl border border-charcoal/10 bg-white/60 p-4">
                    <div class="flex items-center justify-between gap-3">
                      <h3 class="text-sm font-semibold text-charcoal">{c.name}</h3>
                      <span class={`rounded-full px-3 py-1 text-xs font-medium ${c.active ? 'bg-green-deep/10 text-green-deep' : 'bg-charcoal/10 text-charcoal/60'}`}>
                        {c.active ? c.onLabel : c.offLabel}
                      </span>
                    </div>
                    {c.desc && <p class="mt-2 text-sm leading-relaxed text-charcoal/70">{c.desc}</p>}
                  </div>
                ))}
              </div>
            )}
            {s.note && <p class="mt-3 text-xs leading-relaxed text-charcoal/55">{s.note}</p>}
            {s.actions && (
              <div class="mt-4 flex flex-wrap gap-3">
                {s.actions.map((a: any) => (
                  <button class={`rounded-lg px-4 py-2 text-sm font-medium ${a.primary ? 'bg-green-deep text-cream hover:bg-green-deep/90' : 'border border-charcoal/20 text-charcoal hover:bg-charcoal/5'}`}>
                    {a.label}
                  </button>
                ))}
              </div>
            )}
          </div>
        ))
      }
    </div>
    <a href={`/${lang}`} class="mt-10 inline-block text-sm font-medium text-green-deep hover:underline">
      ← {messages.header.siteName}
    </a>
  </div>
</section>
