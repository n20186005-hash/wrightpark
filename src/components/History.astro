---
interface Props {
  lang: string;
  messages: any;
}
const { messages } = Astro.props;
const history = messages.history;
const sections = history.sections ?? [];
const legend = history.legend;
const stories = legend?.stories ?? [];
---

<section id="history" class="scroll-mt-20 bg-cream py-16 md:py-24">
  <div class="mx-auto max-w-6xl px-4">
    <p class="section-eyebrow">{history.eyebrow}</p>
    <h2 class="mt-2 font-serif text-3xl font-bold text-green-deep md:text-4xl">{history.title}</h2>
    <p class="mt-3 max-w-2xl text-charcoal/70">{history.subtitle}</p>

    <ol class="mt-10 space-y-8 border-l-2 border-gold/40 pl-6">
      {
        sections.map((s: any) => (
          <li class="relative">
            <span class="absolute -left-[31px] top-1 flex h-5 w-5 items-center justify-center rounded-full bg-gold ring-4 ring-cream" />
            <p class="text-xs font-semibold uppercase tracking-wide text-gold-deep">{s.era}</p>
            <h3 class="mt-1 font-serif text-xl font-semibold text-charcoal">{s.heading}</h3>
            <p class="mt-2 max-w-2xl text-sm leading-relaxed text-charcoal/75">{s.body}</p>
          </li>
        ))
      }
    </ol>

    {
      legend && (
        <div class="mt-14 rounded-2xl border border-gold/30 bg-sand/60 p-6 md:p-8">
          <p class="section-eyebrow">{legend.eyebrow}</p>
          <h3 class="mt-2 font-serif text-2xl font-bold text-green-deep">{legend.title}</h3>
          <p class="mt-2 max-w-2xl text-sm text-charcoal/70">{legend.intro}</p>
          <div class="mt-6 space-y-5">
            {
              stories.map((st: any) => (
                <div class="rounded-xl bg-white/60 p-5">
                  <h4 class="font-serif text-lg font-semibold text-charcoal">{st.title}</h4>
                  <p class="mt-2 text-sm leading-relaxed text-charcoal/75">{st.body}</p>
                </div>
              ))
            }
          </div>
          <p class="mt-4 text-xs leading-relaxed text-charcoal/55">{legend.note}</p>
        </div>
      )
    }
  </div>
</section>
