---
interface Props {
  lang: string;
  messages: any;
}
const { messages } = Astro.props;
const seasons = messages.seasons;
const rows = seasons.rows ?? [];
const cols = seasons.columns ?? {};
---

<section id="seasons" class="scroll-mt-20 bg-cream py-16 md:py-24">
  <div class="mx-auto max-w-6xl px-4">
    <p class="section-eyebrow">{seasons.eyebrow}</p>
    <h2 class="mt-2 font-serif text-3xl font-bold text-green-deep md:text-4xl">{seasons.title}</h2>
    <p class="mt-3 max-w-2xl text-charcoal/70">{seasons.subtitle}</p>

    <div class="mt-8 overflow-hidden rounded-2xl border border-gold/25 bg-white/70">
      <div class="overflow-x-auto">
        <table class="w-full min-w-[720px] border-collapse text-left text-sm">
          <thead class="bg-green-deep text-white">
            <tr>
              <th scope="col" class="px-4 py-3 font-semibold">{cols.season}</th>
              <th scope="col" class="px-4 py-3 font-semibold">{cols.months}</th>
              <th scope="col" class="px-4 py-3 font-semibold">{cols.climate}</th>
              <th scope="col" class="px-4 py-3 font-semibold">{cols.crowd}</th>
              <th scope="col" class="px-4 py-3 font-semibold">{cols.strategy}</th>
            </tr>
          </thead>
          <tbody>
            {
              rows.map((row: any) => (
                <tr class="border-t border-gold/20 align-top">
                  <th scope="row" class="px-4 py-4 font-semibold text-green-deep">{row.season}</th>
                  <td class="px-4 py-4 text-charcoal/80">{row.months}</td>
                  <td class="px-4 py-4 text-charcoal/80">{row.climate}</td>
                  <td class="px-4 py-4 text-charcoal/80">{row.crowd}</td>
                  <td class="px-4 py-4 text-charcoal/80">{row.strategy}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>

    <p class="mt-5 max-w-4xl text-xs leading-relaxed text-charcoal/60">{seasons.note}</p>
  </div>
</section>
