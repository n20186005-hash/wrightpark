---
import Icon from './Icon.astro';

interface Props {
  lang: string;
  messages: any;
}
const { messages } = Astro.props;
const science = messages.science;
const items = science.items ?? [];
const duties = science.responsibility ?? [];
---

<section id="science" class="scroll-mt-20 bg-sand/60 py-16 md:py-24">
  <div class="mx-auto max-w-6xl px-4">
    <p class="section-eyebrow">{science.eyebrow}</p>
    <h2 class="mt-2 font-serif text-3xl font-bold text-green-deep md:text-4xl">{science.title}</h2>
    <p class="mt-3 max-w-2xl text-charcoal/70">{science.subtitle}</p>

    <div class="mt-8 grid gap-4 md:grid-cols-2">
      {
        items.map((item: any) => (
          <article class="glass-card rounded-2xl p-6">
            <div class="flex items-center gap-3">
              <span class="rounded-full bg-green-deep/10 p-2.5 text-green-deep">
                <Icon name={item.icon} class="w-5 h-5" />
              </span>
              <h3 class="font-serif text-lg font-semibold text-charcoal">{item.title}</h3>
            </div>
            <p class="mt-3 text-sm leading-relaxed text-charcoal/80">{item.text}</p>
          </article>
        ))
      }
    </div>

    <div class="mt-6 rounded-2xl border border-green-deep/20 bg-green-deep/5 p-6">
      <h3 class="flex items-center gap-2 font-serif text-lg font-semibold text-green-deep">
        <Icon name="shield" class="w-5 h-5" />
        {science.responsibilityTitle}
      </h3>
      <ul class="mt-4 grid gap-2 md:grid-cols-2">
        {
          duties.map((duty: string) => (
            <li class="flex items-start gap-2 text-sm leading-relaxed text-charcoal/85">
              <Icon name="leaf" class="mt-0.5 w-4 h-4 shrink-0 text-gold-deep" />
              <span>{duty}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <p class="mt-5 max-w-4xl text-xs leading-relaxed text-charcoal/60">{science.note}</p>
  </div>
</section>
