---
import Icon from './Icon.astro';
import { mapsUrl } from '../config';

interface Props {
  lang: string;
  messages: any;
}
const { lang, messages } = Astro.props;
const footer = messages.footer;

const exploreLinks = [
  { id: 'intro', label: messages.header.intro },
  { id: 'history', label: messages.header.history },
  { id: 'guide', label: messages.header.guide },
  { id: 'transport', label: messages.header.transport },
  { id: 'facilities', label: messages.header.facilities },
  { id: 'faq', label: messages.header.faq },
];
const resources = footer.resources ?? [];
---

<footer class="bg-green-deep text-cream">
  <div class="mx-auto max-w-6xl px-4 py-14">
    <div class="grid gap-10 md:grid-cols-4">
      <div class="md:col-span-1">
        <div class="flex items-center gap-2 font-serif text-xl font-semibold">
          <Icon name="park" class="w-6 h-6 text-gold" />
          <span>{footer.siteName}</span>
        </div>
        <p class="mt-3 text-sm text-cream/80">{footer.tagline}</p>
        <p class="mt-4 text-xs leading-relaxed text-cream/70">{footer.rights}</p>
      </div>

      <div>
        <h3 class="font-serif text-sm font-semibold uppercase tracking-wide text-gold">{footer.exploreTitle}</h3>
        <ul class="mt-4 space-y-2 text-sm">
          {
            exploreLinks.map((l) => (
              <li>
                <a href={`/${lang}#${l.id}`} class="text-cream/80 transition hover:text-gold">
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h3 class="font-serif text-sm font-semibold uppercase tracking-wide text-gold">{footer.resourcesTitle}</h3>
        <ul class="mt-4 space-y-2 text-sm">
          {
            resources.map((r: any) => (
              <li>
                <a href={r.url} target="_blank" rel="noopener" class="text-cream/80 transition hover:text-gold">
                  {r.label}
                </a>
              </li>
            ))
          }
          <li>
            <a href={mapsUrl} target="_blank" rel="noopener" class="text-cream/80 transition hover:text-gold">
              Google Maps
            </a>
          </li>
        </ul>
      </div>

      <div>
        <h3 class="font-serif text-sm font-semibold uppercase tracking-wide text-gold">{footer.visitTitle}</h3>
        <p class="mt-4 text-sm text-cream/80">{footer.addressLabel}: {footer.addressValue}</p>
        <a
          href={mapsUrl}
          target="_blank"
          rel="noopener"
          class="mt-3 inline-flex items-center gap-1 text-sm font-semibold text-gold transition hover:text-white"
        >
          <Icon name="map" class="w-4 h-4" />
          {footer.mapsLabel}
        </a>
      </div>
    </div>

    <div class="mt-10 border-t border-cream/20 pt-6">
      <p class="text-xs leading-relaxed text-cream/70">{footer.missionTitle}: {footer.missionText}</p>
      <p class="mt-3 text-xs leading-relaxed text-cream/60">{footer.disclaimer}</p>
    </div>

    <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm">
      <a href={`/${lang}/privacy-policy`} class="text-cream/85 transition hover:text-gold">{footer.privacy}</a>
      <a href={`/${lang}/terms-of-service`} class="text-cream/85 transition hover:text-gold">{footer.terms}</a>
      <a href={`/${lang}/cookie-settings`} class="text-cream/85 transition hover:text-gold">{footer.cookie}</a>
    </div>

    <p class="mt-6 text-xs text-cream/60">© {new Date().getFullYear()} {footer.siteName}.</p>
  </div>
</footer>
