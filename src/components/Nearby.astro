---
import Icon from './Icon.astro';

interface Props {
  lang: string;
  messages: any;
}
const { messages } = Astro.props;
const near = messages.nearby;
const spots = near.spots ?? [];
const route = near.route;
const steps = route?.steps ?? [];
---

<section id="nearby" class="scroll-mt-20 bg-cream py-16 md:py-24">
  <div class="mx-auto max-w-6xl px-4">
    <p class="section-eyebrow">{near.eyebrow}</p>
    <h2 class="mt-2 font-serif text-3xl font-bold text-green-deep md:text-4xl">{near.title}</h2>
    <p class="mt-3 max-w-2xl text-charcoal/70">{near.subtitle}</p>

    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        spots.map((s: any) => (
          <article class="glass-card flex items-start gap-3 rounded-2xl p-5">
            <span class="rounded-full bg-green-deep/10 p-2 text-green-deep">
              <Icon name={s.icon ?? 'pin'} class="w-5 h-5" />
            </span>
            <div>
              <h3 class="font-serif text-base font-semibold text-charcoal">{s.name}</h3>
              <p class="mt-1 text-xs text-charcoal/50">{s.distance}</p>
              <p class="mt-2 text-sm leading-relaxed text-charcoal/75">{s.desc}</p>
            </div>
          </article>
        ))
      }
    </div>

    <div class="mt-10 rounded-2xl border border-gold/30 bg-sand/60 p-6">
      <div class="flex items-center gap-2 text-green-deep">
        <Icon name="route" class="w-5 h-5" />
        <h3 class="font-serif text-lg font-semibold">{route.title}</h3>
      </div>
      <p class="mt-2 text-sm text-charcoal/70">{route.intro}</p>
      <ol class="mt-5 space-y-4">
        {
          steps.map((step: any, i: number) => (
            <li class="flex items-start gap-4">
              <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-green-deep font-semibold text-white">
                {i + 1}
              </span>
              <div class="flex-1">
                <p class="font-medium text-charcoal">{step.place}</p>
                <p class="text-sm text-charcoal/70">{step.note}</p>
              </div>
              <span class="shrink-0 text-xs font-semibold text-gold-deep">{step.time}</span>
            </li>
          ))
        }
      </ol>
      <p class="mt-4 text-xs text-charcoal/55">{route.note}</p>
    </div>
  </div>
</section>
