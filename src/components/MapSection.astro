---
import Icon from './Icon.astro';
import { mapsUrl, mapsEmbedSrc, govtTourismUrl } from '../config';

interface Props {
  lang: string;
  messages: any;
}
const { messages } = Astro.props;
const map = messages.map;
---

<section id="map" class="scroll-mt-20 bg-sand/60 py-16 md:py-24">
  <div class="mx-auto max-w-6xl px-4">
    <p class="section-eyebrow">{map.eyebrow}</p>
    <h2 class="mt-2 font-serif text-3xl font-bold text-green-deep md:text-4xl">{map.title}</h2>
    <p class="mt-3 max-w-2xl text-charcoal/70">{map.subtitle}</p>

    <div class="mt-8 grid gap-6 md:grid-cols-3">
      <div class="glass-card rounded-2xl p-6 md:col-span-1">
        <div class="space-y-4">
          <div>
            <p class="text-xs uppercase tracking-wide text-charcoal/55">{map.addressLabel}</p>
            <p class="mt-1 font-medium text-charcoal">{map.addressValue}</p>
          </div>
          <div>
            <p class="text-xs uppercase tracking-wide text-charcoal/55">{map.hoursLabel}</p>
            <p class="mt-1 font-medium text-charcoal">{map.hoursValue}</p>
          </div>
          <a
            href={mapsUrl}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-2 rounded-full bg-green-deep px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-green"
          >
            <Icon name="map" class="w-4 h-4" />
            {map.openLabel}
          </a>
        </div>
      </div>

      <div class="overflow-hidden rounded-2xl border border-gold/30 shadow-lg md:col-span-2">
        <iframe
          title={map.title}
          src={mapsEmbedSrc}
          loading="lazy"
          referrerpolicy="strict-origin-when-cross-origin"
          class="h-72 w-full md:h-96"
          style="border:0"
          allowfullscreen
        ></iframe>
      </div>
    </div>

    {
      map.govtLinkIntro && (
        <p class="mt-8 text-sm text-charcoal/70">
          {map.govtLinkIntro}{' '}
          <a
            href={govtTourismUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="font-semibold text-green-deep underline decoration-dotted underline-offset-2 transition hover:text-gold-deep"
          >
            {map.govtLinkLabel}
          </a>
        </p>
      )
    }
  </div>
</section>
