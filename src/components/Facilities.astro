---
import Icon from './Icon.astro';

interface Props {
  lang: string;
  messages: any;
}
const { messages } = Astro.props;
const facilities = messages.facilities;
const cards = facilities.cards ?? [];
---

<section id="facilities" class="scroll-mt-20 bg-cream py-16 md:py-24">
  <div class="mx-auto max-w-6xl px-4">
    <p class="section-eyebrow">{facilities.eyebrow}</p>
    <h2 class="mt-2 font-serif text-3xl font-bold text-green-deep md:text-4xl">{facilities.title}</h2>
    <p class="mt-3 max-w-2xl text-charcoal/70">{facilities.subtitle}</p>

    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        cards.map((c: any) => (
          <div class="glass-card rounded-2xl p-6">
            <span class="flex h-12 w-12 items-center justify-center rounded-full bg-green-deep/10 text-green-deep">
              <Icon name={c.icon} class="w-7 h-7" />
            </span>
            <h3 class="mt-4 font-serif text-lg font-semibold text-charcoal">{c.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-charcoal/75">{c.text}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
