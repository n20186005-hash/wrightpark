---
import Icon from './Icon.astro';

interface Props {
  lang: string;
  messages: any;
}
const { messages } = Astro.props;
const transport = messages.transport;
const modes = transport.modes ?? [];
---

<section id="transport" class="scroll-mt-20 bg-sand/60 py-16 md:py-24">
  <div class="mx-auto max-w-6xl px-4">
    <p class="section-eyebrow">{transport.eyebrow}</p>
    <h2 class="mt-2 font-serif text-3xl font-bold text-green-deep md:text-4xl">{transport.title}</h2>
    <p class="mt-3 max-w-2xl text-charcoal/70">{transport.overview}</p>

    <div class="mt-8 grid gap-4 sm:grid-cols-2">
      {
        modes.map((m: any) => (
          <div class="glass-card rounded-2xl p-6">
            <div class="flex items-center gap-3">
              <span class="rounded-full bg-green/10 p-3 text-green-deep">
                <Icon name={m.icon} class="w-7 h-7" />
              </span>
              <h3 class="font-serif text-lg font-semibold text-charcoal">{m.title}</h3>
            </div>
            <p class="mt-3 text-sm leading-relaxed text-charcoal/75">{m.description}</p>
            <ul class="mt-4 space-y-2">
              {m.details?.map((d: string) => (
                <li class="flex items-start gap-2 text-sm text-charcoal/70">
                  <span class="mt-1 h-1.5 w-1.5 shrink-0 rounded-full bg-gold-deep" />
                  <span>{d}</span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
