---
import Icon from './Icon.astro';
import { govtTourismUrl, mapsUrl } from '../config';

interface Props {
  lang: string;
  messages: any;
}
const { messages } = Astro.props;
const sources = messages.sources;
const items = sources?.items ?? [];
---

<section id="sources" class="scroll-mt-20 bg-sand/60 py-16 md:py-24">
  <div class="mx-auto max-w-6xl px-4">
    <p class="section-eyebrow">{sources.eyebrow}</p>
    <h2 class="mt-2 font-serif text-3xl font-bold text-green-deep md:text-4xl">{sources.title}</h2>
    <p class="mt-3 max-w-3xl text-charcoal/70">{sources.intro}</p>

    <div class="mt-8 space-y-3">
      {
        items.map((s: any) => (
          <article class="glass-card rounded-2xl p-5">
            <div class="flex flex-wrap items-baseline justify-between gap-2">
              <h3 class="font-semibold text-charcoal">{s.label}</h3>
              <span class="text-xs font-semibold uppercase tracking-wide text-gold-deep">{s.meta}</span>
            </div>
            <p class="mt-2 text-sm leading-relaxed text-charcoal/75">{s.note}</p>
            <a
              href={s.url}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-3 inline-flex items-center gap-1 text-sm font-semibold text-green-deep underline decoration-dotted underline-offset-2 transition hover:text-gold-deep"
            >
              <Icon name="globe" class="w-4 h-4" />
              {s.url}
            </a>
          </article>
        ))
      }
    </div>

    <div class="mt-8 rounded-2xl border border-gold/30 bg-cream/80 p-5">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
          <p class="text-xs uppercase tracking-wide text-charcoal/55">{sources.reviewRowLabel}</p>
          <p class="mt-1 text-sm font-semibold text-charcoal">{sources.syncedLabel}</p>
        </div>
        <a
          href={mapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-full bg-green-deep px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-green"
        >
          <Icon name="star" class="w-4 h-4" />
          {sources.linkLabel}
        </a>
      </div>
      <p class="mt-4 text-xs leading-relaxed text-charcoal/70">
        <span class="font-semibold text-charcoal">{sources.sourceNoteLabel}: </span>{sources.sourceNote}
      </p>
    </div>

    <p class="mt-6 text-sm text-charcoal/70">
      {messages.map?.govtLinkIntro}{' '}
      <a
        href={govtTourismUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="font-semibold text-green-deep underline decoration-dotted underline-offset-2 transition hover:text-gold-deep"
      >
        {messages.map?.govtLinkLabel}
      </a>
    </p>
  </div>
</section>
