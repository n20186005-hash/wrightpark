---
import Icon from './Icon.astro';

interface Props {
  lang: string;
  messages: any;
}
const { messages } = Astro.props;
const guide = messages.guide;
const steps = guide.route?.steps ?? [];
const tips = guide.tips?.items ?? [];
---

<section id="guide" class="scroll-mt-20 bg-sand/60 py-16 md:py-24">
  <div class="mx-auto max-w-6xl px-4">
    <p class="section-eyebrow">{guide.eyebrow}</p>
    <h2 class="mt-2 font-serif text-3xl font-bold text-green-deep md:text-4xl">{guide.title}</h2>
    <p class="mt-3 max-w-2xl text-charcoal/70">{guide.subtitle}</p>

    <div class="mt-8 grid gap-6 md:grid-cols-2">
      <div class="glass-card rounded-2xl p-6">
        <div class="flex items-center gap-2 text-green-deep">
          <Icon name="walk" class="w-5 h-5" />
          <h3 class="font-serif text-lg font-semibold">{guide.route.title}</h3>
        </div>
        <ol class="mt-5 space-y-4">
          {
            steps.map((step: string, i: number) => (
              <li class="flex items-center gap-4">
                <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-green-deep font-semibold text-white">
                  {i + 1}
                </span>
                <span class="text-charcoal/85">{step}</span>
                {i < steps.length - 1 && (
                  <Icon name="arrow" class="ml-auto w-4 h-4 text-gold-deep" />
                )}
              </li>
            ))
          }
        </ol>
      </div>

      <div class="glass-card rounded-2xl p-6">
        <div class="flex items-center gap-2 text-green-deep">
          <Icon name="users" class="w-5 h-5" />
          <h3 class="font-serif text-lg font-semibold">{guide.tips.title}</h3>
        </div>
        <ul class="mt-5 space-y-3">
          {
            tips.map((item: string) => (
              <li class="flex items-start gap-3 text-sm text-charcoal/80">
                <span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-gold-deep" />
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
