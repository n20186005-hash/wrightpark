---
interface Props {
  lang: string;
  messages: any;
}
const { messages } = Astro.props;
const best = messages.bestTime;
const day = best.day ?? [];

const tones: Record<string, string> = {
  morning: 'from-sky-100 to-cream ring-sky-200',
  afternoon: 'from-amber-100 to-cream ring-amber-200',
  evening: 'from-indigo-100 to-cream ring-indigo-200',
};
const scoreTone: Record<string, string> = {
  morning: 'bg-sky-200/70 text-sky-900',
  afternoon: 'bg-amber-200/70 text-amber-900',
  evening: 'bg-indigo-200/70 text-indigo-900',
};
---

<section id="best-time" class="scroll-mt-20 bg-cream py-16 md:py-24">
  <div class="mx-auto max-w-6xl px-4">
    <p class="section-eyebrow">{best.eyebrow}</p>
    <h2 class="mt-2 font-serif text-3xl font-bold text-green-deep md:text-4xl">{best.title}</h2>
    <p class="mt-3 max-w-2xl text-charcoal/70">{best.subtitle}</p>

    <div class="mt-8 grid gap-4 md:grid-cols-3">
      {
        day.map((d: any) => (
          <div class={`glass-card rounded-2xl bg-gradient-to-b ${tones[d.tone] ?? 'to-cream'} p-6 ring-1`}>
            <div class="flex items-center justify-between">
              <h3 class="font-serif text-xl font-semibold text-charcoal">{d.label}</h3>
              <span class={`rounded-full px-3 py-1 text-xs font-semibold ${scoreTone[d.tone] ?? 'bg-gold/20 text-gold-deep'}`}>
                {d.score}
              </span>
            </div>
            <p class="mt-3 text-sm leading-relaxed text-charcoal/75">{d.text}</p>
          </div>
        ))
      }
    </div>

    <div class="mt-6 flex items-start gap-3 rounded-xl border border-amber-300/60 bg-amber-50 p-4">
      <span class="mt-0.5 text-amber-600">⚠</span>
      <p class="text-sm text-amber-900/80">{best.note}</p>
    </div>
  </div>
</section>
