---
import Icon from './Icon.astro';
import { mapsUrl } from '../config';

interface Props {
  lang: string;
  messages: any;
}
const { messages } = Astro.props;
const gallery = messages.gallery;
const photos = gallery.photos ?? [];
---

<section id="gallery" class="scroll-mt-20 bg-cream py-16 md:py-24">
  <div class="mx-auto max-w-6xl px-4">
    <p class="section-eyebrow">{gallery.eyebrow}</p>
    <h2 class="mt-2 font-serif text-3xl font-bold text-green-deep md:text-4xl">{gallery.title}</h2>
    <p class="mt-3 max-w-2xl text-charcoal/70">{gallery.subtitle}</p>

    <div class="mt-8 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
      {
        photos.map((p: any) => (
          <figure class="group overflow-hidden rounded-2xl border border-gold/20 bg-sand">
            <img
              src={`/gallery/${p.file}`}
              alt={p.alt}
              loading="lazy"
              class="h-44 w-full object-cover transition duration-500 group-hover:scale-105"
            />
            <figcaption class="px-3 py-2 text-xs text-charcoal/70">{p.caption}</figcaption>
          </figure>
        ))
      }
    </div>

    <div class="mt-8 flex flex-col items-start justify-between gap-4 rounded-2xl bg-sand/70 p-5 sm:flex-row sm:items-center">
      <p class="text-sm text-charcoal/70">{gallery.creditNote}</p>
      <a
        href={mapsUrl}
        target="_blank"
        rel="noopener"
        class="inline-flex shrink-0 items-center gap-2 rounded-full border border-green-deep px-5 py-2 text-sm font-semibold text-green-deep transition hover:bg-green-deep hover:text-white"
      >
        <Icon name="map" class="w-4 h-4" />
        {gallery.viewMaps}
      </a>
    </div>
  </div>
</section>
