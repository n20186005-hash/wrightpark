---
import Icon from './Icon.astro';

interface Props {
  lang: string;
  messages: any;
}
const { messages } = Astro.props;
const audiences = messages.audiences;
const plans = audiences.plans ?? [];
---

<section id="audiences" class="scroll-mt-20 bg-sand/60 py-16 md:py-24">
  <div class="mx-auto max-w-6xl px-4">
    <p class="section-eyebrow">{audiences.eyebrow}</p>
    <h2 class="mt-2 font-serif text-3xl font-bold text-green-deep md:text-4xl">{audiences.title}</h2>
    <p class="mt-3 max-w-2xl text-charcoal/70">{audiences.subtitle}</p>

    <div class="mt-8 grid gap-6 lg:grid-cols-3">
      {
        plans.map((plan: any) => (
          <div class="glass-card flex flex-col rounded-2xl p-6">
            <div class="flex items-center gap-3">
              <span class="rounded-full bg-gold/20 p-3 text-gold-deep">
                <Icon name={plan.icon} class="w-6 h-6" />
              </span>
              <h3 class="font-serif text-lg font-semibold text-charcoal">{plan.title}</h3>
            </div>

            <dl class="mt-4 flex flex-wrap gap-2 text-xs">
              <span class="rounded-full bg-green-deep/10 px-3 py-1 text-green-deep">
                {audiences.durationLabel}: {plan.duration}
              </span>
              <span class="rounded-full bg-cream px-3 py-1 text-charcoal/70">
                {audiences.paceLabel}: {plan.pace}
              </span>
            </dl>

            <h4 class="mt-5 text-xs font-semibold uppercase tracking-wide text-green-deep">{audiences.focusLabel}</h4>
            <ul class="mt-2 space-y-2">
              {plan.focus.map((item: string) => (
                <li class="flex items-start gap-2 text-sm text-charcoal/80">
                  <span class="mt-1 h-1.5 w-1.5 shrink-0 rounded-full bg-gold-deep" />
                  <span>{item}</span>
                </li>
              ))}
            </ul>

            <h4 class="mt-5 text-xs font-semibold uppercase tracking-wide text-green-deep">{audiences.tipsLabel}</h4>
            <ul class="mt-2 space-y-2">
              {plan.tips.map((item: string) => (
                <li class="flex items-start gap-2 text-sm text-charcoal/80">
                  <Icon name="info" class="mt-0.5 w-4 h-4 shrink-0 text-green-deep" />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
