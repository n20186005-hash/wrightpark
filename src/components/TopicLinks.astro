---
interface Props {
  lang: string;
  messages: any;
}
const { messages } = Astro.props;
const links = messages.topicLinks ?? [];
---

{
  links.length > 0 && (
    <section id="visitor-guides" class="scroll-mt-20 bg-sand/60 py-16 md:py-20">
      <div class="mx-auto max-w-6xl px-4">
        <p class="section-eyebrow">Visitor guides</p>
        <h2 class="mt-2 font-serif text-3xl font-bold text-green-deep md:text-4xl">Plan your visit to Wright Park</h2>
        <p class="mt-3 max-w-2xl text-charcoal/70">
          Focused guides for the most common visitor questions about Wright Park in Baguio.
        </p>
        <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {
            links.map((l: any) => (
              <a
                href={`/en/${l.slug}`}
                class="group flex flex-col rounded-2xl border border-charcoal/10 bg-white/70 p-5 transition hover:border-gold/40 hover:bg-white"
              >
                <span class="font-serif text-lg font-semibold text-green-deep group-hover:text-gold-deep">{l.label}</span>
                <span class="mt-2 text-sm leading-relaxed text-charcoal/70">{l.desc}</span>
                <span class="mt-4 text-sm font-medium text-green-deep">Read guide →</span>
              </a>
            ))
          }
        </div>
      </div>
    </section>
  )
}
