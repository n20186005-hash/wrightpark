{
  "name": "wright-park",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "cf:dev": "npm run build && wrangler dev",
    "cf:deploy": "npm run build && cross-env CURRENT_SITE_DOMAIN=wrightpark.org wrangler deploy",
    "deploy": "npm run cf:deploy"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "astro": "^5.5.0",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "typescript": "^5.9.3",
    "wrangler": "^4.0.0",
    "cross-env": "^7.0.3"
  }
}
